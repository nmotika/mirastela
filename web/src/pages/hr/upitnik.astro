---
// Tester questionnaire (Croatian only, testers only; behind Cloudflare Access like the rest of the site).
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';

type Q =
  | { id: string; type: 'scale'; q: string; lo: string; hi: string; max?: number; min?: number }
  | { id: string; type: 'choice'; q: string; opts: string[] }
  | { id: string; type: 'text'; q: string; hint?: string };

const sections: { title: string; qs: Q[] }[] = [
  { title: 'Prolazak kroz stranicu', qs: [
    { id: 'kraj', type: 'choice', q: 'Jesi li uspio/la doći do kraja, do svog izvještaja?', opts: ['Da, bez problema', 'Da, ali negdje sam zapeo/la', 'Ne, odustao/la sam'] },
    { id: 'lakoca', type: 'scale', q: 'Koliko je bilo jednostavno proći korake od datuma rođenja do izvještaja?', lo: 'Jako teško', hi: 'Jako lako' },
    { id: 'zapelo', type: 'text', q: 'Je li nešto bilo zbunjujuće, sporo ili ne radi?', hint: 'Npr. korak na kojem si zastao/la, greška, nešto nejasno' },
  ] },
  { title: 'Natalna karta', qs: [
    { id: 'prepoznavanje', type: 'scale', q: 'Koliko si se prepoznao/la u tekstu natalne karte?', lo: 'Uopće ne', hi: 'Potpuno' },
    { id: 'dojam', type: 'scale', q: 'Kako ti se čini tekst: osoban i konkretan ili općenit?', lo: 'Općenit', hi: 'Osoban' },
    { id: 'najbolje', type: 'text', q: 'Što ti se u izvještaju najviše svidjelo?' },
    { id: 'suvisno', type: 'text', q: 'Što je bilo predugo, suvišno ili nejasno?' },
  ] },
  { title: 'Ponuda', qs: [
    { id: 'ponuda_jasnoca', type: 'scale', q: 'Koliko je ekran s ponudom jasan: što dobivaš i koliko košta?', lo: 'Nejasno', hi: 'Potpuno jasno' },
    { id: 'ponuda_kupnja', type: 'choice', q: 'Da nisi imao/la kod, bi li na tom ekranu kupio/la izvještaj?', opts: ['Da', 'Možda', 'Ne'] },
    { id: 'ponuda_komentar', type: 'text', q: 'Što bi te uvjerilo da kupiš, ili što te odbija?' },
  ] },
  { title: 'Besplatni dnevni horoskop', qs: [
    { id: 'dnevni_ocjena', type: 'scale', q: 'Kako ti se čini besplatni dnevni horoskop za tvoj znak?', lo: 'Loše', hi: 'Odlično' },
    { id: 'dnevni_citanje', type: 'choice', q: 'Bi li ga čitao/la svaki dan?', opts: ['Da', 'Možda', 'Ne'] },
    { id: 'dnevni_komentar', type: 'text', q: 'Dojam o dnevnom horoskopu: što valja, a što ne?' },
  ] },
  { title: 'Kompatibilnost i horoskop', qs: [
    { id: 'partner', type: 'choice', q: 'Jesi li isprobao/la kompatibilnost s partnerom?', opts: ['Da, i bilo je zanimljivo', 'Da, ali ništa posebno', 'Ne'] },
    { id: 'horoskop', type: 'choice', q: 'Bi li redovito čitao/la osobni tjedni horoskop mailom?', opts: ['Da', 'Možda', 'Ne'] },
  ] },
  { title: 'Cijena', qs: [
    { id: 'cijena_karta', type: 'choice', q: 'Koliko bi najviše platio/la za ovakvu natalnu kartu?', opts: ['Ne bih platio/la', 'Do 5 €', '5 do 10 €', '10 do 20 €', 'Više od 20 €'] },
    { id: 'cijena_pretplata', type: 'choice', q: 'A za osobni horoskop mailom, mjesečno?', opts: ['Ne bih platio/la', 'Do 3 €', '3 do 5 €', '5 do 10 €', 'Više od 10 €'] },
    { id: 'preporuka', type: 'scale', q: 'Koliko je vjerojatno da bi ovo preporučio/la prijatelju?', lo: 'Nikako', hi: 'Sigurno', min: 0, max: 10 },
  ] },
  { title: 'Za kraj', qs: [
    { id: 'ostalo', type: 'text', q: 'Bilo što drugo što bi mi htio/htjela poručiti?' },
  ] },
];
const range = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
---
<Base lang="hr" path="upitnik/" title="Upitnik za testere · Mirastela" description="Upitnik za testere" noindex>
  <div class="wrap"><Header lang="hr" path="upitnik/" nav={false} /></div>
  <main class="fb">
    <form id="fb" novalidate>
      <p class="ey">Hvala što testiraš</p>
      <h1 class="sf">Upitnik</h1>
      <p class="mu lead">Treba ti 5 minuta. Upitnik je anoniman: ne spremamo tko je što odgovorio, pa slobodno piši otvoreno. Kritika mi puno pomaže, a nijedno pitanje nije obavezno.</p>
      {sections.map((s) => (
        <section class="sec">
          <h2>{s.title}</h2>
          {s.qs.map((q) => (
            <fieldset class="q">
              <legend>{q.q}</legend>
              {q.type === 'scale' && (
                <div class:list={['scale', { wide: (q.max ?? 5) > 5 }]}>
                  {range(q.min ?? 1, q.max ?? 5).map((n) => (
                    <label><input type="radio" name={q.id} value={n} /><span>{n}</span></label>
                  ))}
                </div>
              )}
              {q.type === 'scale' && <div class="ends mu"><span>{q.lo}</span><span>{q.hi}</span></div>}
              {q.type === 'choice' && (
                <div class="opts">
                  {q.opts.map((o) => <label><input type="radio" name={q.id} value={o} /><span>{o}</span></label>)}
                </div>
              )}
              {q.type === 'text' && <textarea class="inp" name={q.id} rows="3" maxlength="3000" placeholder={q.hint ?? ''}></textarea>}
            </fieldset>
          ))}
        </section>
      ))}
      <p class="ferr" id="err" hidden>Slanje nije uspjelo. Pokušaj ponovno za minutu.</p>
      <button class="btn" type="submit" id="send">Pošalji odgovore</button>
    </form>
    <section id="thanks" class="thanks" hidden>
      <p class="ey">Primljeno</p>
      <h1 class="sf">Hvala ti!</h1>
      <p class="mu lead">Tvoji odgovori su stigli. Horoskop ti i dalje stiže mailom, a ako se sjetiš još nečega, slobodno mi samo odgovori na mail.</p>
      <a class="btn2" href="/hr/">Natrag na početnu</a>
    </section>
  </main>
</Base>

<script>
  const form = document.getElementById('fb') as HTMLFormElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('send') as HTMLButtonElement;
    const err = document.getElementById('err')!;
    btn.disabled = true; err.hidden = true;
    const answers: Record<string, string | number | null> = {};
    const fd = new FormData(form);
    form.querySelectorAll<HTMLElement>('fieldset').forEach((f) => {
      const el = f.querySelector<HTMLInputElement | HTMLTextAreaElement>('[name]');
      if (!el) return;
      const v = fd.get(el.name);
      const s = typeof v === 'string' ? v.trim() : '';
      answers[el.name] = s === '' ? null : el.closest('.scale') ? Number(s) : s;
    });
    try {
      const res = await fetch('/api/feedback', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ answers }) });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      (document.getElementById('thanks') as HTMLElement).hidden = false;
      window.scrollTo({ top: 0 });
    } catch {
      err.hidden = false; btn.disabled = false;
    }
  });
</script>

<style>
  .fb { width: 100%; max-width: 640px; margin: 0 auto; padding: 16px 20px 64px; }
  #fb, .thanks { display: flex; flex-direction: column; gap: 16px; }
  h1 { font-size: 40px; line-height: 1.1; }
  .lead { font-size: 17px; }
  .sec { display: flex; flex-direction: column; gap: 12px; margin-top: 20px; }
  .sec h2 { font: 700 12px var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--gold); }
  .q { margin: 0; padding: 18px; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .q legend { float: left; width: 100%; padding: 0; margin-bottom: 12px; font: 400 20px/1.3 var(--serif); }
  .scale { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; clear: both; }
  .scale.wide { grid-template-columns: repeat(11, 1fr); gap: 4px; }
  .scale label, .opts label { cursor: pointer; }
  .scale input, .opts input { position: absolute; opacity: 0; pointer-events: none; }
  .scale span { display: flex; align-items: center; justify-content: center; height: 48px; border-radius: 12px; border: 1px solid var(--border-strong); font-weight: 700; font-variant-numeric: tabular-nums; }
  .scale.wide span { height: 44px; font-size: 14px; border-radius: 10px; }
  .scale input:checked + span, .opts input:checked + span { background: var(--gold); border-color: var(--gold); color: var(--bg); }
  .scale input:focus-visible + span, .opts input:focus-visible + span { outline: 2px solid var(--gold); outline-offset: 2px; }
  .ends { display: flex; justify-content: space-between; font-size: 13px; }
  .opts { display: flex; flex-direction: column; gap: 8px; clear: both; }
  .opts span { display: flex; align-items: center; min-height: 48px; padding: 10px 16px; border-radius: 12px; border: 1px solid var(--border-strong); font-weight: 600; }
  .opts label:hover span, .scale label:hover span { border-color: var(--gold); }
  textarea.inp { clear: both; min-height: 96px; font-size: 16px; resize: vertical; }
  #send { margin-top: 12px; }
  .thanks { padding-top: 40px; }
  .thanks .btn2 { align-self: flex-start; }
</style>
