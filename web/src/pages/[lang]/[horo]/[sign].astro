---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HoroCta from '../../../components/HoroCta.astro';
import { LOCALES, INTL, type Lang } from '../../../i18n/config';
import { t, fill } from '../../../i18n';
import { SIGN_GLYPHS, signRange } from '../../../scripts/zodiac';
import '../../../styles/horo.css';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => {
    const H = t(lang).horo;
    return H.signSlugs.map((sign, idx) => ({ params: { lang, horo: H.slug, sign }, props: { idx } }));
  });
}
const lang = Astro.params.lang as Lang;
const { idx } = Astro.props as { idx: number };
const d = t(lang);
const H = d.horo;
const name = d.astro.signs[idx];
const paths = Object.fromEntries(LOCALES.map((l) => [l, `${t(l).horo.slug}/${t(l).horo.signSlugs[idx]}/`])) as Record<Lang, string>;
const clientData = JSON.stringify({ lang, page: 'sign', idx, d: { horo: H, astro: d.astro } });
---
<Base lang={lang} path={paths[lang]} paths={paths} title={fill(H.signTitle, { sign: name })} description={fill(H.signDesc, { sign: name })}>
  <div class="wrap"><Header lang={lang} path={paths[lang]} paths={paths} /></div>
  <main class="wrap horo one">
    <nav class="crumbs mu"><a href={`/${lang}/${H.slug}/`}>{H.nav}</a> / {name}</nav>
    <div class="signhead">
      <span class="gl bigglyph" aria-hidden="true">{SIGN_GLYPHS[idx]}</span>
      <div>
        <p class="ey" id="hDate">&nbsp;</p>
        <h1 class="sf">{fill(H.signH1, { sign: name })}</h1>
        <p class="mu">{signRange(INTL[lang], idx)}</p>
      </div>
    </div>

    <article class="paper reading" aria-live="polite">
      <p id="hStatus" class="pm">{H.loading}</p>
      <div id="hBody" hidden>
        <h2 class="sf">{H.general}</h2><p id="hGeneral"></p>
        <h2 class="sf">{H.love}</h2><p id="hLove"></p>
        <h2 class="sf">{H.work}</h2><p id="hWork"></p>
      </div>
    </article>

    <section class="skybox">
      <h2 class="sf">{H.sky}</h2>
      <p class="mu" id="hSky">{H.loading}</p>
    </section>
    <HoroCta lang={lang} />

    <h2 class="sf others">{H.others}</h2>
    <ul class="mini">
      {d.astro.signs.map((s, i) => i !== idx && (
        <li><a href={`/${lang}/${H.slug}/${H.signSlugs[i]}/`}><span class="gl" aria-hidden="true">{SIGN_GLYPHS[i]}</span>{s}</a></li>
      ))}
    </ul>
  </main>
  <Footer lang={lang} path={paths[lang]} paths={paths} />
  <script type="application/json" id="horo-data" set:html={clientData} />
  <script src="../../../scripts/horo.ts"></script>
</Base>
