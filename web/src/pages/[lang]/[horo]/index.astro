---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { LOCALES, type Lang } from '../../../i18n/config';
import { t } from '../../../i18n';
import { SIGN_GLYPHS, signRangeShort } from '../../../scripts/zodiac';
import '../../../styles/horo.css';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang, horo: t(lang).horo.slug } }));
}
const lang = Astro.params.lang as Lang;
const d = t(lang);
const H = d.horo;
const paths = Object.fromEntries(LOCALES.map((l) => [l, `${t(l).horo.slug}/`])) as Record<Lang, string>;
const clientData = JSON.stringify({ lang, page: 'index', d: { horo: H } });
---
<Base lang={lang} path={paths[lang]} paths={paths} title={H.indexTitle} description={H.indexDesc}>
  <div class="wrap"><Header lang={lang} path={paths[lang]} paths={paths} /></div>
  <main class="horo hwrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={`/${lang}/`}>Mirastela</a> / {H.nav}</nav>
    <section class="hh">
      <h1 class="sf">{H.h1}</h1>
      <p class="hdate" data-hdate>&nbsp;</p>
      <p class="mu">{H.pick}</p>
    </section>
    <nav class="zgrid" aria-label={H.h1}>
      {d.astro.signs.map((s, i) => (
        <a href={`/${lang}/${H.slug}/${H.signSlugs[i]}/`} class="zc"><span class="g gl" aria-hidden="true">{SIGN_GLYPHS[i]}</span><b>{s}</b><small>{signRangeShort(i)}</small></a>
      ))}
    </nav>
    <section class="pcta">
      <p class="ek">{H.ctaEyebrow}</p>
      <h2 class="sf">{H.ctaIdxTitle}</h2>
      <p>{H.ctaIdxText}</p>
      <a href={`/${lang}/start/`} class="btn">{H.ctaBtn}</a>
    </section>
    <section class="about">
      <h2 class="sf">{H.aboutTitle}</h2>
      <p class="mu">{H.aboutText}</p>
    </section>
  </main>
  <Footer lang={lang} path={paths[lang]} paths={paths} />
  <script type="application/json" id="horo-data" set:html={clientData} />
  <script src="../../../scripts/horo.ts"></script>
</Base>
