---
// "How we work": methodology page (how positions are calculated and how texts are written).
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { LOCALES, type Lang } from '../../i18n/config';
import { TRUST } from '../../i18n/lang/trust';
import { ldJson, crumbsLd } from '../../lib/seo';

const files = import.meta.glob<{ Content: any }>('../../content/method/*.md', { eager: true });

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang, about: TRUST[lang].slug } }));
}
const lang = Astro.params.lang as Lang;
const T = TRUST[lang];
const paths = Object.fromEntries(LOCALES.map((l) => [l, `${TRUST[l].slug}/`])) as Record<Lang, string>;
const Content = (files[`../../content/method/${lang}.md`] ?? files['../../content/method/en.md']).Content;
const ld = ldJson([
  crumbsLd([['Mirastela', `/${lang}/`], [T.nav, `/${lang}/${paths[lang]}`]]),
  { '@context': 'https://schema.org', '@type': 'AboutPage', name: T.nav, description: T.desc, inLanguage: lang, url: `https://mirastela.com/${lang}/${paths[lang]}`,
    about: { '@type': 'Organization', name: 'Mirastela', legalName: 'Something Digital d.o.o.', url: 'https://mirastela.com/', email: 'hello@mirastela.com' } },
]);
---
<Base lang={lang} path={paths[lang]} paths={paths} title={T.title} description={T.desc}>
  <script slot="head" type="application/ld+json" set:html={ld} />
  <div class="wrap"><Header lang={lang} path={paths[lang]} paths={paths} /></div>
  <main class="wrap legal">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={`/${lang}/`}>Mirastela</a> / {T.nav}</nav>
    <Content />
  </main>
  <Footer lang={lang} path={paths[lang]} paths={paths} />
</Base>
