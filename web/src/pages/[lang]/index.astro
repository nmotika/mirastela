---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { LOCALES, type Lang } from '../../i18n/config';
import { t } from '../../i18n';
import { wheelSvg, SAMPLE_WHEEL } from '../../scripts/wheel';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const d = t(lang);
const L = d.landing;
const wheel = wheelSvg(SAMPLE_WHEEL, { size: 340, label: L.eyebrow, animate: true });
const icons = [
  '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  '<path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.5"/>',
];
const start = `/${lang}/start/`;
---
<Base lang={lang} path="" title={d.meta.title} description={d.meta.description}>
  <div class="wrap"><Header lang={lang} path="" /></div>
  <main>
    <section class="wrap hero">
      <div class="hero-text">
        <p class="ey">{L.eyebrow}</p>
        <h1 class="sf">{L.h1}</h1>
        <p class="mu lead">{L.sub}</p>
        <div class="cta">
          <a href={start} class="btn">{L.cta}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <p class="mu note">{L.ctaNote}</p>
        </div>
      </div>
      <div class="hero-wheel" set:html={wheel} />
    </section>

    <ul class="wrap trust">
      {L.trust.map((x, i) => (
        <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D9B26A" stroke-width="1.6" aria-hidden="true" set:html={icons[i]} /><span>{x}</span></li>
      ))}
    </ul>

    <div class="wrap two">
      <section class="how">
        <h2 class="sf">{L.howTitle}</h2>
        <ol>
          {L.how.map(([title, desc], i) => (
            <li><span class="sf num">{i + 1}</span><div><strong>{title}</strong><span class="mu">{desc}</span></div></li>
          ))}
        </ol>
      </section>
      <section class="paper inc">
        <p class="ey">{L.incEyebrow}</p>
        <h2 class="sf">{L.incTitle}</h2>
        <ul>{L.inc.map((x) => <li>{x}</li>)}</ul>
      </section>
    </div>

    <section class="wrap final">
      <h2 class="sf">{L.finalTitle}</h2>
      <p class="mu">{L.finalSub}</p>
      <a href={start} class="btn">{L.cta}</a>
    </section>
  </main>
  <Footer lang={lang} path="" />
</Base>

<style>
  .hero { display: grid; gap: 28px; padding-top: 28px; padding-bottom: 40px; }
  .hero-text { display: flex; flex-direction: column; gap: 20px; }
  h1 { font-size: clamp(40px, 9vw, 64px); line-height: 1.06; text-wrap: balance; }
  .lead { font-size: 17px; text-wrap: pretty; max-width: 34em; }
  .cta { display: flex; flex-direction: column; gap: 10px; max-width: 420px; }
  .note { font-size: 14px; text-align: center; }
  .hero-wheel { display: flex; justify-content: center; }
  .trust { list-style: none; margin: 0 auto; padding-bottom: 48px; display: grid; }
  .trust li { display: flex; align-items: center; gap: 14px; padding: 16px 0; border-top: 1px solid var(--line); font-weight: 600; }
  .trust li:last-child { border-bottom: 1px solid var(--line); }
  .two { display: grid; gap: 40px; }
  .how h2, .final h2 { font-size: 30px; line-height: 1.15; }
  .how ol { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 22px; }
  .how li { display: flex; gap: 16px; }
  .how li > div { display: flex; flex-direction: column; gap: 4px; }
  .how strong { font-size: 17px; }
  .num { font-size: 28px; color: var(--gold); line-height: 1; width: 28px; flex: none; }
  .inc { padding: 32px 20px; display: flex; flex-direction: column; gap: 18px; }
  .inc h2 { font-size: 28px; line-height: 1.15; }
  .inc ul { list-style: none; margin: 0; padding: 0; }
  .inc li { padding: 12px 0; border-top: 1px solid var(--paper-line); }
  .inc li:last-child { border-bottom: 1px solid var(--paper-line); }
  .final { padding-top: 56px; display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center; max-width: 520px; }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 1.1fr .9fr; align-items: center; padding-top: 56px; padding-bottom: 72px; }
    .trust { grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .trust li, .trust li:last-child { border-bottom: 1px solid var(--line); }
    .two { grid-template-columns: 1fr 1fr; align-items: start; }
    .inc { padding: 40px; }
  }
</style>
