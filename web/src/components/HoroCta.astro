---
import { t } from '../i18n';
import type { Lang } from '../i18n/config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const H = t(lang).horo;
---
<section class="horocta">
  <h2 class="sf">{H.ctaTitle}</h2>
  <p class="mu">{H.ctaText}</p>
  <a class="btn" href={`/${lang}/start/`}>{H.ctaBtn}</a>
</section>
