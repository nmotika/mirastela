---
import '../styles/global.css';
import Consent from '../components/Consent.astro';
import { LOCALES, INTL, type Lang } from '../i18n/config';
interface Props { lang: Lang; path: string; paths?: Record<Lang, string>; title: string; description: string; noindex?: boolean }
const { lang, path, paths, title, description, noindex } = Astro.props;
const at = (l: Lang) => paths?.[l] ?? path; // localized slugs differ per language
const site = 'https://mirastela.com';
---
<!doctype html>
<html lang={INTL[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="format-detection" content="telephone=no" />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={`${site}/${lang}/${at(lang)}`} />
  {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={`${site}/${l}/${at(l)}`} />)}
  <link rel="alternate" hreflang="x-default" href={`${site}/en/${at('en')}`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0B1020" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Noto+Sans+Symbols&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <Consent lang={lang} />
</body>
</html>
